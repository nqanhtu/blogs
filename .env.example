# Content Repository Strategy: 'local' (filesystem) or 'github' (GitHub Contents API)
CONTENT_REPOSITORY=local

# Base URL for canonical links, RSS feed, sitemap, and Open Graph
PUBLIC_SITE_URL=http://localhost:3000

# GitHub Integration (Required when CONTENT_REPOSITORY=github)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_CONTENT_DIRECTORY=content/articles

# Admin Authentication & Security
# For production:
# 1. Generate a secure custom password hash:
#    pnpm admin:hash-password <your-strong-password>
# 2. Generate a fresh random 32-byte secret for session signing:
#    node -e "console.log(crypto.randomBytes(32).toString('hex'))"
#
# Below are pre-configured demo credentials for LOCAL DEVELOPMENT ONLY (password: "admin"):
ADMIN_PASSWORD_HASH=9261f9d45e54619934333eaec84423402fbfa81b8359d9c2fa7c844391ab1a12:83624e5d6255152a55ce65dc7f699042
SESSION_SECRET=c38e3e414c330f61548a3d42bc42c10a48b3fe08975871f76020c2d3855a9018
