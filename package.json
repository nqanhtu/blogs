{
  "name": "personal-markdown-research-publisher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "tsr generate && vite build",
    "preview": "vite preview",
