    "admin:hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/highlight": "0.0.10",
