    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.41.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.33",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.8.2",
    "vite": "^8.0.0",
